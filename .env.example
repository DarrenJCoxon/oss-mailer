# API authentication
# Generate with: openssl rand -base64 32
MAILER_API_KEY=

# Dashboard authentication (Auth.js + Google OAuth)
# Generate with: npx auth secret
AUTH_SECRET=
# Google OAuth client credentials from Google Cloud Console
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated allowlist; sign-in fails closed when this is empty
AUTH_ALLOWED_EMAILS=

# Sender address — must be a verified domain or email in AWS SES
# Format: "Display Name <address@yourdomain.com>"
MAILER_FROM="oss-mailer <noreply@yourdomain.com>"

# AWS SES credentials
# The secret access key should be kept secure — never commit real values
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=     # Your AWS IAM secret key (keep this private)
SES_REGION=eu-west-2

# Category → provider routing (currently only 'ses' is supported)
MAGIC_LINK_PROVIDER=ses
# Optional: defaults to MAGIC_LINK_PROVIDER when omitted.
TRANSACTIONAL_PROVIDER=ses
PROMOTIONAL_PROVIDER=ses
UPDATE_PROVIDER=ses

# Neon database connection string
# Get from: https://console.neon.tech
DATABASE_URL=

# Upstash QStash — for async email queue
# Get all three values from: https://console.upstash.com/qstash
QSTASH_URL="https://qstash-eu-central-1.upstash.io"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

DELIVER_URL=http://localhost:3000/api/queue/deliver
